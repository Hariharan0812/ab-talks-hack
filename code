/* ---------------- effects ---------------- */
function toast(icon,title,sub){
  const wrap = document.getElementById("toastWrap");
  const el = document.createElement("div");
  el.className = "toast";
  el.innerHTML = `<div class="ic">${icon}</div><div><b>${title}</b><span>${sub}</span></div>`;
  wrap.appendChild(el);
  requestAnimationFrame(()=>el.classList.add("show"));
  setTimeout(()=>{ el.classList.remove("show"); setTimeout(()=>el.remove(),300); }, 2600);
}
function confettiBurst(){
  const colors = ["#3EF2A0","#FF9B42","#6BFFC0"];
  const c = document.createElement("div");
  c.className = "confetti";
  for(let i=0;i<26;i++){
    const p = document.createElement("i");
    p.style.left = (10+Math.random()*80)+"%";
    p.style.top = "60px";
    p.style.background = colors[i%3];
    p.style.animationDelay = (Math.random()*.3)+"s";
    p.style.transform = `rotate(${Math.random()*360}deg)`;
    c.appendChild(p);
  }
  document.body.appendChild(c);
  setTimeout(()=>c.remove(),2000);
}
function initReveal(){
  const els = document.querySelectorAll(".rv");
  const io = new IntersectionObserver((entries)=>{
    entries.forEach(e=>{ if(e.isIntersecting){ e.target.classList.add("in"); io.unobserve(e.target); } });
  },{threshold:.12});
  els.forEach(el=>io.observe(el));
}
function initLandingInteractions(){
  const nav = document.getElementById("mainNav");
  const navCta = document.getElementById("navCta");
  window.addEventListener("scroll", ()=>{
    if(window.scrollY>420) navCta.classList.add("show"); else navCta.classList.remove("show");
  });

  const tracks = [
    {name:"Full-Stack Web", d:"Ship a real feature a day, front to back — from a form to a full flow by day 60.", rows:[["Day 1","A static landing section, deployed"],["Day 20","Auth + a protected route"],["Day 60","A full project, launched"]]},
    {name:"DSA Daily", d:"One problem a day, explained in your own words in the commit message — not just solved.", rows:[["Day 1","Arrays & two pointers"],["Day 20","Trees & recursion"],["Day 60","Mock interview set, timed"]]},
    {name:"Applied ML", d:"Train, evaluate, and write up one small model a day. No toy notebooks that die after class.", rows:[["Day 1","Your first trained classifier"],["Day 20","A model behind a real API"],["Day 60","A deployed ML demo"]]},
    {name:"Mobile Builds", d:"A shippable screen or feature every night — real device builds, not just Figma.", rows:[["Day 1","Your first working screen"],["Day 20","Local storage + navigation"],["Day 60","An app on your phone, done"]]},
  ];
  function renderTrack(i){
    const t = tracks[i];
    document.getElementById("trackDetail").innerHTML = `<div class="track-detail"><h4>${t.name}</h4><p>${t.d}</p><div class="tl">${t.rows.map(r=>`<div><b>${r[0]}</b> — ${r[1]}</div>`).join("")}</div></div>`;
  }
  renderTrack(0);
  document.querySelectorAll("#trackTabs button").forEach(b=>{
    b.addEventListener("click", ()=>{
      document.querySelectorAll("#trackTabs button").forEach(x=>x.classList.remove("on"));
      b.classList.add("on"); renderTrack(+b.dataset.t);
    });
  });

  const qt = document.getElementById("quoteTrack");
  const dots = document.querySelectorAll("#quoteDots i");
  qt.addEventListener("scroll", ()=>{
    const idx = Math.round(qt.scrollLeft / qt.clientWidth * 0.9);
    dots.forEach((d,i)=>d.classList.toggle("on", i===Math.min(idx,2)));
  });
}
function initDashboardInteractions(){
  const grid = document.getElementById("dashGrid");
  const tip = document.getElementById("cellTip");
  if(grid){
    grid.querySelectorAll(".cell").forEach(cell=>{
      cell.addEventListener("click",(e)=>{
        const day = cell.dataset.day, s = cell.dataset.s;
        const label = s==="done"?"Shipped":s==="today"?"Today — pending":s==="missed"?"Missed":"Not yet unlocked";
        const rect = cell.getBoundingClientRect();
        tip.style.left = (rect.left+rect.width/2)+"px"; tip.style.top = rect.top+"px";
        tip.textContent = `Day ${day} · ${label}`; tip.classList.add("show");
        clearTimeout(window._tipT); window._tipT = setTimeout(()=>tip.classList.remove("show"),1400);
      });
    });
  }
}
function initDayInteractions(n){
  const items = document.querySelectorAll(".spec-item");
  const counter = document.getElementById("specCounter");
  function updateCount(){
    if(!counter) return;
    const total = items.length, done = document.querySelectorAll(".spec-item.checked").length;
    counter.textContent = `${done}/${total}`;
    const fill = document.getElementById("dayProgFill");
    if(fill) fill.style.width = (done/total*40)+"%"; // spec = first 40%, proof = remaining 60%
  }
  items.forEach(it=>{
    it.addEventListener("click", ()=>{
      it.classList.toggle("checked");
      it.querySelector(".chk").textContent = it.classList.contains("checked") ? "✓" : "";
      updateCount();
    });
  });
  updateCount();

  const repo = document.getElementById("inputRepo");
  const li = document.getElementById("inputLi");
  const submitBtn = document.getElementById("submitBtn");
  function validate(){
    if(!repo || !li) return;
    const repoOk = /github\.com\/.+\/.+/.test(repo.value.trim());
    const liOk = /linkedin\.com\/.+/.test(li.value.trim());
    document.getElementById("rowRepo").classList.toggle("valid", repoOk);
    document.getElementById("rowLi").classList.toggle("valid", liOk);
    document.getElementById("tickRepo").classList.toggle("show", repoOk);
    document.getElementById("tickLi").classList.toggle("show", liOk);
    submitBtn.disabled = !(repoOk && liOk);
    const fill = document.getElementById("dayProgFill");
    if(fill){
      const base = document.querySelectorAll(".spec-item.checked").length / (items.length||1) * 40;
      const proof = (repoOk?30:0) + (liOk?30:0);
      fill.style.width = Math.min(100, base+proof) + "%";
    }
  }
  if(repo){ repo.addEventListener("input", validate); li.addEventListener("input", validate); }

  if(submitBtn){
    submitBtn.addEventListener("click", ()=>{
      submitBtn.disabled = true;
      submitBtn.textContent = "Logging…";
      setTimeout(()=>{
        STREAK += 1;
        confettiBurst();
        toast("🔥","Streak extended","Day "+n+" logged · "+STREAK+" days running");
        document.getElementById("proofCard").innerHTML = `
          <div class="success-card">
            <div class="big-tick">✓</div>
            <h3>Day ${n} logged</h3>
            <p>Your grid just lit up. See you back here for day ${n+1}.</p>
            <a href="#/dashboard" class="btn btn-primary">Back to dashboard</a>
          </div>`;
        const fill = document.getElementById("dayProgFill");
        if(fill) fill.style.width = "100%";
        const tag = document.querySelector(".day-meta .tag.warn");
        if(tag){ tag.textContent = "✓ Submitted"; tag.className = "tag ok"; }
        const pill = document.getElementById("streakPill");
        const num = document.getElementById("streakNum");
        if(num) num.textContent = STREAK;
        if(pill){ pill.classList.add("bump"); setTimeout(()=>pill.classList.remove("bump"),400); }
      }, 700);
    });
  }
}

/* ---------------- router ---------------- */
function render(){
  const hash = location.hash || "#/";
  const app = document.getElementById("app");
  const dayMatch = hash.match(/^#\/day\/(\d+)/);
  app.style.opacity = 0;

  if(hash.startsWith("#/dashboard")){
    app.innerHTML = pageDashboard();
    requestAnimationFrame(initDashboardInteractions);
  } else if(dayMatch){
    const n = parseInt(dayMatch[1],10);
    app.innerHTML = pageDay(n);
    requestAnimationFrame(()=>initDayInteractions(n));
  } else {
    app.innerHTML = pageLanding();
    requestAnimationFrame(()=>{ initReveal(); initLandingInteractions(); });
  }
  window.scrollTo(0,0);
  requestAnimationFrame(()=>{ app.style.transition="opacity .25s ease"; app.style.opacity=1; });
}
window.addEventListener("hashchange", render);
if(!location.hash) location.hash = "#/";
render();
</script>
