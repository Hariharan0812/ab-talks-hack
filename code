<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>ABTalks — 60 Day Challenge</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#0A0E0C; --bg-2:#070A08;
    --surface:#121815; --surface-2:#182019; --surface-3:#1D2620;
    --border:#233029; --border-soft:#1A231D; --border-hi:#33463A;
    --text:#EDF5EF; --text-dim:#B4C2BB; --text-muted:#7C8C82;
    --mint:#3EF2A0; --mint-hi:#6BFFC0; --mint-ink:#06150E; --mint-dim:rgba(62,242,160,.14);
    --amber:#FF9B42; --amber-dim:rgba(255,155,66,.15);
    --red:#E2585B; --red-dim:rgba(226,88,91,.13);
    --radius:16px;
    --disp:'Space Grotesk',sans-serif; --body:'Inter',sans-serif; --mono:'JetBrains Mono',monospace;
    --ease:cubic-bezier(.16,1,.3,1);
  }
  *{box-sizing:border-box;margin:0;padding:0;}
  html{background:var(--bg);scroll-behavior:smooth;}
  body{background:var(--bg);color:var(--text);font-family:var(--body);-webkit-font-smoothing:antialiased;min-height:100vh;line-height:1.5;}
  a{color:inherit;text-decoration:none;} button{font-family:inherit;cursor:pointer;border:none;background:none;color:inherit;}
  ::selection{background:var(--mint);color:var(--mint-ink);}
  :focus-visible{outline:2px solid var(--mint);outline-offset:2px;border-radius:4px;}
  img,svg{display:block;}
  .shell{max-width:480px;margin:0 auto;min-height:100vh;position:relative;background:var(--bg);border-left:1px solid var(--border-soft);border-right:1px solid var(--border-soft);overflow-x:hidden;}
  @media(min-width:481px){ body{background:var(--bg-2);} }

  /* reveal on scroll */
  .rv{opacity:0;transform:translateY(14px);transition:opacity .6s var(--ease),transform .6s var(--ease);}
  .rv.in{opacity:1;transform:translateY(0);}
  @media (prefers-reduced-motion: reduce){ .rv{opacity:1;transform:none;transition:none;} }

  .eyebrow{font-family:var(--mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--text-muted);}
  .mono{font-family:var(--mono);}
  .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;font-family:var(--body);font-weight:700;font-size:15px;padding:15px 20px;border-radius:11px;transition:transform .15s var(--ease), box-shadow .2s var(--ease), background .15s ease, opacity .15s ease;width:100%;}
  .btn:active{transform:scale(.97);}
  .btn-primary{background:var(--mint);color:var(--mint-ink);box-shadow:0 0 0 0 rgba(62,242,160,.4);}
  .btn-primary:hover{background:var(--mint-hi);box-shadow:0 6px 24px -6px rgba(62,242,160,.45);}
  .btn-ghost{background:var(--surface-2);color:var(--text);border:1px solid var(--border);}
  .btn-ghost:hover{border-color:var(--border-hi);background:var(--surface-3);}
  .btn-sm{width:auto;padding:10px 15px;font-size:13px;border-radius:9px;}
  .btn[disabled]{opacity:.4;pointer-events:none;}

  /* ---- signature grid ---- */
  .grid60{display:grid;grid-template-columns:repeat(10,1fr);gap:5px;}
  .cell{aspect-ratio:1;border-radius:4px;background:var(--surface-2);border:1px solid var(--border);position:relative;transition:background .4s var(--ease), border-color .4s var(--ease), transform .15s ease;}
  .cell[data-s="done"]{background:var(--mint);border-color:var(--mint);}
  .cell[data-s="today"]{background:var(--amber-dim);border:1.5px solid var(--amber);animation:pulse 1.8s ease-in-out infinite;}
  .cell[data-s="missed"]{background:transparent;border:1px solid var(--red);opacity:.55;}
  .cell[data-s="future"]{background:transparent;border:1px dashed var(--border);}
  .cell[data-s="lit"]{background:var(--mint-dim);border-color:#2E5B45;}
  .cell.tap:active{transform:scale(.85);}
  @keyframes pulse{0%,100%{box-shadow:0 0 0 0 var(--amber-dim);}50%{box-shadow:0 0 0 6px var(--amber-dim);}}
  @media (prefers-reduced-motion: reduce){ .cell[data-s="today"]{animation:none;} }
  .cell-tip{position:fixed;transform:translate(-50%,-115%);background:var(--surface-3);border:1px solid var(--border-hi);color:var(--text);font-family:var(--mono);font-size:11px;padding:6px 9px;border-radius:8px;pointer-events:none;z-index:80;opacity:0;transition:opacity .12s ease;white-space:nowrap;}
  .cell-tip.show{opacity:1;}

  /* ---- toast ---- */
  .toast-wrap{position:fixed;top:14px;left:50%;transform:translateX(-50%);z-index:200;width:calc(100% - 32px);max-width:448px;pointer-events:none;}
  .toast{display:flex;align-items:center;gap:10px;background:var(--surface-3);border:1px solid var(--mint);border-radius:12px;padding:12px 14px;box-shadow:0 12px 32px -8px rgba(0,0,0,.5);opacity:0;transform:translateY(-14px);transition:opacity .3s var(--ease),transform .3s var(--ease);}
  .toast.show{opacity:1;transform:translateY(0);}
  .toast .ic{font-size:16px;}
  .toast b{font-size:13px;} .toast span{font-size:11.5px;color:var(--text-muted);display:block;font-family:var(--mono);}

  /* confetti */
  .confetti{position:fixed;inset:0;pointer-events:none;z-index:150;overflow:hidden;}
  .confetti i{position:absolute;top:-10px;width:7px;height:11px;border-radius:2px;opacity:0;animation:fall 1.6s ease-in forwards;}
  @keyframes fall{0%{opacity:1;transform:translateY(0) rotate(0deg);}100%{opacity:0;transform:translateY(340px) rotate(340deg);}}

  /* ================= NAV / LANDING ================= */
  .nav{display:flex;align-items:center;justify-content:space-between;padding:16px 20px;position:sticky;top:0;z-index:40;background:rgba(10,14,12,.82);backdrop-filter:blur(12px);border-bottom:1px solid var(--border-soft);transition:border-color .3s ease;}
  .logo{font-family:var(--disp);font-weight:700;font-size:18px;letter-spacing:-.01em;display:flex;align-items:center;gap:8px;}
  .logo .dot{width:8px;height:8px;border-radius:2px;background:var(--mint);display:inline-block;box-shadow:0 0 10px var(--mint);}
  .nav-cta{font-family:var(--body);font-weight:700;font-size:13px;background:var(--mint);color:var(--mint-ink);padding:9px 14px;border-radius:8px;opacity:0;transform:translateY(-6px);transition:opacity .25s var(--ease),transform .25s var(--ease);pointer-events:none;}
  .nav-cta.show{opacity:1;transform:translateY(0);pointer-events:auto;}
  .nav-login{font-size:13px;color:var(--text-dim);}

  .hero{padding:44px 20px 0;position:relative;}
  .mesh{position:absolute;top:-60px;left:-40px;width:340px;height:340px;background:radial-gradient(circle,rgba(62,242,160,.16),transparent 65%);pointer-events:none;filter:blur(10px);}
  .hero .eyebrow{margin-bottom:16px;position:relative;}
  .hero h1{font-family:var(--disp);font-size:40px;line-height:1.04;letter-spacing:-.025em;font-weight:700;margin-bottom:16px;position:relative;}
  .hero h1 .accent{color:var(--mint);position:relative;}
  .hero h1 .accent::after{content:"";position:absolute;left:0;right:0;bottom:2px;height:9px;background:var(--mint-dim);z-index:-1;border-radius:3px;}
  .hero p{color:var(--text-dim);font-size:15.5px;margin-bottom:26px;max-width:38ch;position:relative;}
  .hero-ctas{display:flex;flex-direction:column;gap:10px;margin-bottom:10px;position:relative;}
  .hero-note{font-family:var(--mono);font-size:11.5px;color:var(--text-muted);margin-top:10px;display:flex;align-items:center;gap:6px;}
  .hero-note .avatars{display:flex;}
  .hero-note .avatars i{width:16px;height:16px;border-radius:50%;background:var(--surface-3);border:1.5px solid var(--bg);margin-left:-5px;display:inline-block;}

  .hero-grid-wrap{margin:30px 0 6px;padding:16px;border:1px solid var(--border);border-radius:var(--radius);background:linear-gradient(180deg,var(--surface),var(--bg));position:relative;}
  .hero-grid-cap{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:12px;}
  .hero-grid-cap .n{font-family:var(--mono);font-size:12px;color:var(--mint);display:flex;align-items:center;gap:5px;}
  .live-dot{width:6px;height:6px;border-radius:50%;background:var(--mint);display:inline-block;animation:blink 1.6s ease-in-out infinite;}
  @keyframes blink{50%{opacity:.3;}}

  .stats-strip{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--border-soft);border-bottom:1px solid var(--border-soft);margin:20px 0 0;}
  .stat{padding:20px 14px;border-right:1px solid var(--border-soft);}
  .stat:last-child{border-right:none;}
  .stat .num{font-family:var(--disp);font-size:25px;font-weight:700;color:var(--mint);font-variant-numeric:tabular-nums;}
  .stat .lbl{font-family:var(--mono);font-size:10.5px;color:var(--text-muted);margin-top:4px;text-transform:uppercase;letter-spacing:.05em;}

  .section{padding:46px 20px;}
  .section-head{margin-bottom:22px;}
  .section-head .eyebrow{margin-bottom:8px;}
  .section-head h2{font-family:var(--disp);font-size:25px;font-weight:700;letter-spacing:-.01em;}

  .steps{display:flex;flex-direction:column;gap:0;}
  .step{display:flex;gap:16px;padding:18px 0;border-top:1px solid var(--border-soft);transition:padding-left .25s var(--ease);}
  .step:last-child{border-bottom:1px solid var(--border-soft);}
  .step:hover{padding-left:6px;}
  .step .num{font-family:var(--mono);font-size:13px;color:var(--mint);padding-top:2px;width:22px;flex-shrink:0;}
  .step h3{font-family:var(--body);font-weight:600;font-size:15px;margin-bottom:4px;}
  .step p{font-size:13.5px;color:var(--text-muted);}

  .tab-switch{display:flex;gap:6px;margin-bottom:18px;background:var(--surface);border:1px solid var(--border);padding:4px;border-radius:11px;}
  .tab-switch button{flex:1;padding:9px 6px;font-size:12px;font-weight:600;border-radius:8px;color:var(--text-muted);transition:all .2s ease;font-family:var(--mono);}
  .tab-switch button.on{background:var(--mint);color:var(--mint-ink);}
  .track-detail{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:20px;}
  .track-detail h4{font-family:var(--disp);font-size:19px;font-weight:700;margin-bottom:8px;}
  .track-detail p{font-size:13.5px;color:var(--text-dim);margin-bottom:16px;}
  .track-detail .tl{display:flex;flex-direction:column;gap:8px;}
  .track-detail .tl div{display:flex;align-items:center;gap:9px;font-size:12.5px;color:var(--text-muted);font-family:var(--mono);}
  .track-detail .tl div b{color:var(--mint);}

  .lb-row{display:flex;align-items:center;gap:12px;padding:12px 0;border-top:1px solid var(--border-soft);}
  .lb-row:last-child{border-bottom:1px solid var(--border-soft);}
  .lb-rank{font-family:var(--mono);font-size:13px;color:var(--text-muted);width:22px;}
  .lb-rank.top{color:var(--mint);}
  .lb-av{width:32px;height:32px;border-radius:9px;background:var(--surface-3);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;font-family:var(--disp);font-size:12px;color:var(--mint);flex-shrink:0;}
  .lb-name{flex:1;font-size:13.5px;font-weight:600;}
  .lb-name span{display:block;font-size:11px;color:var(--text-muted);font-weight:400;font-family:var(--mono);}
  .lb-streak{font-family:var(--mono);font-size:12.5px;color:var(--amber);}

  .quote-track{display:flex;gap:12px;overflow-x:auto;scroll-snap-type:x mandatory;margin:0 -20px;padding:0 20px 6px;}
  .quote-card{flex:0 0 88%;scroll-snap-align:start;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:18px;}
  .quote-card p{font-size:14px;color:var(--text-dim);margin-bottom:14px;}
  .quote-who{display:flex;align-items:center;gap:10px;}
  .quote-who .av{width:30px;height:30px;border-radius:8px;background:var(--surface-3);display:flex;align-items:center;justify-content:center;font-family:var(--mono);font-size:11px;color:var(--mint);border:1px solid var(--border);}
  .quote-who .meta{font-size:12px;}
  .quote-who .meta b{display:block;font-weight:600;font-size:13px;}
  .quote-who .meta span{color:var(--text-muted);font-family:var(--mono);font-size:10.5px;}
  .dots{display:flex;gap:6px;justify-content:center;margin-top:14px;}
  .dots i{width:5px;height:5px;border-radius:50%;background:var(--border-hi);}
  .dots i.on{background:var(--mint);width:14px;border-radius:3px;}

  .faq-item{border-top:1px solid var(--border-soft);}
  .faq-item:last-child{border-bottom:1px solid var(--border-soft);}
  .faq-item summary{list-style:none;cursor:pointer;display:flex;align-items:center;justify-content:space-between;padding:16px 0;font-weight:600;font-size:14px;}
  .faq-item summary::-webkit-details-marker{display:none;}
  .faq-item .plus{color:var(--mint);font-family:var(--mono);transition:transform .25s ease;font-size:16px;}
  .faq-item[open] .plus{transform:rotate(45deg);}
  .faq-item .a{padding:0 0 16px;font-size:13.5px;color:var(--text-muted);max-width:42ch;}

  .final-cta{padding:50px 20px 60px;border-top:1px solid var(--border-soft);position:relative;overflow:hidden;}
  .final-cta::before{content:"";position:absolute;bottom:-60px;right:-60px;width:200px;height:200px;background:radial-gradient(circle,rgba(62,242,160,.12),transparent 65%);}
  .final-cta h2{font-family:var(--disp);font-size:27px;font-weight:700;margin-bottom:10px;letter-spacing:-.01em;position:relative;}
  .final-cta p{color:var(--text-muted);font-size:14px;margin-bottom:22px;position:relative;}

  .foot{padding:22px 20px 34px;border-top:1px solid var(--border-soft);display:flex;justify-content:space-between;align-items:center;}

  /* ================= APP ================= */
  .appbar{display:flex;align-items:center;justify-content:space-between;padding:16px 20px 14px;position:sticky;top:0;z-index:40;background:rgba(10,14,12,.9);backdrop-filter:blur(12px);border-bottom:1px solid var(--border-soft);}
  .appbar-left{display:flex;align-items:center;gap:10px;}
  .back-btn{width:34px;height:34px;border-radius:9px;background:var(--surface-2);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;transition:background .15s ease;}
  .back-btn:hover{background:var(--surface-3);}
  .streak-pill{display:flex;align-items:center;gap:6px;background:var(--amber-dim);border:1px solid rgba(255,155,66,.35);padding:6px 10px;border-radius:20px;font-family:var(--mono);font-size:12.5px;color:var(--amber);font-weight:600;transition:transform .3s var(--ease);}
  .streak-pill.bump{animation:bump .4s var(--ease);}
  @keyframes bump{0%{transform:scale(1);}40%{transform:scale(1.18);}100%{transform:scale(1);}}
  .avatar{width:32px;height:32px;border-radius:9px;background:var(--surface-3);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;font-family:var(--disp);font-size:12px;color:var(--mint);}

  .app-main{padding:20px 20px 100px;}
  .greet{margin-bottom:6px;display:flex;justify-content:space-between;align-items:flex-start;}
  .greet h1{font-family:var(--disp);font-size:24px;font-weight:700;letter-spacing:-.01em;}
  .greet p{color:var(--text-muted);font-size:13px;margin-top:4px;}
  .streak-freeze{font-family:var(--mono);font-size:10.5px;color:var(--text-muted);background:var(--surface-2);border:1px solid var(--border);padding:5px 8px;border-radius:7px;display:flex;align-items:center;gap:5px;white-space:nowrap;}
  .greet-line{font-size:13px;color:var(--text-muted);margin-bottom:20px;}

  .card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:18px;margin-bottom:14px;transition:border-color .2s ease;}
  .card-today{background:linear-gradient(155deg,var(--surface-2),var(--surface));border:1px solid #26362D;position:relative;overflow:hidden;display:block;}
  .card-today::before{content:"";position:absolute;top:-30px;right:-30px;width:120px;height:120px;background:radial-gradient(circle,var(--mint-dim),transparent 70%);}
  .card-today:hover{border-color:var(--border-hi);}
  .card-label{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;position:relative;}
  .card-label .eyebrow{color:var(--mint);}
  .badge{font-family:var(--mono);font-size:10.5px;padding:3px 8px;border-radius:20px;background:var(--surface-3);color:var(--text-muted);border:1px solid var(--border);}
  .card-today h2{font-family:var(--disp);font-size:20px;font-weight:700;margin-bottom:6px;position:relative;}
  .card-today p{font-size:13.5px;color:var(--text-dim);margin-bottom:16px;position:relative;}
  .cta-inline{display:inline-flex;align-items:center;gap:6px;width:auto;padding:11px 18px;font-size:13.5px;position:relative;}

  .progress-row{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:10px;}
  .progress-row h3{font-family:var(--body);font-weight:600;font-size:14px;}
  .progress-row .val{font-family:var(--mono);font-size:12px;color:var(--text-muted);}
  .bar{height:6px;border-radius:4px;background:var(--surface-3);overflow:hidden;margin-bottom:8px;}
  .bar-fill{height:100%;background:linear-gradient(90deg,var(--mint),var(--mint-hi));border-radius:4px;transition:width .6s var(--ease);}
  .legend{display:flex;gap:14px;margin-top:12px;flex-wrap:wrap;}
  .legend span{display:flex;align-items:center;gap:6px;font-size:11px;color:var(--text-muted);font-family:var(--mono);}
  .legend i{width:9px;height:9px;border-radius:3px;display:inline-block;}

  .stand-row{display:flex;gap:10px;}
  .stand-item{flex:1;background:var(--surface-2);border:1px solid var(--border);border-radius:11px;padding:14px 12px;text-align:left;transition:border-color .15s ease;}
  .stand-item:hover{border-color:var(--border-hi);}
  .stand-item .num{font-family:var(--disp);font-size:19px;font-weight:700;color:var(--text);}
  .stand-item .lbl{font-family:var(--mono);font-size:10px;color:var(--text-muted);margin-top:3px;}

  .badges-row{display:flex;gap:8px;overflow-x:auto;margin:0 -20px;padding:0 20px;}
  .badge-chip{flex:0 0 auto;display:flex;flex-direction:column;align-items:center;gap:6px;width:64px;}
  .badge-chip .ic{width:44px;height:44px;border-radius:12px;background:var(--surface-2);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:17px;}
  .badge-chip.locked .ic{opacity:.35;}
  .badge-chip span{font-size:9.5px;color:var(--text-muted);text-align:center;font-family:var(--mono);}

  .tabbar{position:fixed;bottom:0;left:0;right:0;max-width:480px;margin:0 auto;background:rgba(13,17,15,.94);backdrop-filter:blur(14px);border-top:1px solid var(--border-soft);display:flex;padding:10px 8px calc(10px + env(safe-area-inset-bottom));z-index:60;}
  .tab{flex:1;display:flex;flex-direction:column;align-items:center;gap:4px;padding:4px;color:var(--text-muted);transition:color .15s ease;}
  .tab.active{color:var(--mint);}
  .tab span{font-family:var(--mono);font-size:9.5px;}
  .tab svg{width:20px;height:20px;}

  /* ================= DAY PAGE ================= */
  .day-progress-bar{height:4px;background:var(--surface-3);border-radius:3px;overflow:hidden;margin-bottom:20px;}
  .day-progress-fill{height:100%;background:var(--mint);border-radius:3px;transition:width .4s var(--ease);}
  .day-head{margin-bottom:18px;}
  .day-head .eyebrow{color:var(--mint);margin-bottom:8px;}
  .day-head h1{font-family:var(--disp);font-size:23px;font-weight:700;letter-spacing:-.01em;margin-bottom:6px;}
  .day-meta{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px;}
  .tag{font-family:var(--mono);font-size:10.5px;padding:4px 9px;border-radius:6px;background:var(--surface-2);border:1px solid var(--border);color:var(--text-dim);}
  .tag.warn{color:var(--amber);border-color:rgba(255,155,66,.35);background:var(--amber-dim);}
  .tag.ok{color:var(--mint);border-color:#2E5B45;background:var(--mint-dim);}
  .countdown{font-family:var(--mono);font-size:10.5px;color:var(--amber);}

  .brief p{font-size:14px;color:var(--text-dim);margin-bottom:14px;}
  .brief h3{font-family:var(--body);font-weight:600;font-size:14px;margin-bottom:10px;display:flex;justify-content:space-between;align-items:center;}
  .brief h3 .sub{font-family:var(--mono);font-size:10.5px;color:var(--text-muted);font-weight:400;}
  .spec-list{display:flex;flex-direction:column;gap:2px;margin-bottom:6px;}
  .spec-item{display:flex;gap:10px;font-size:13.5px;color:var(--text-dim);padding:9px 6px;border-radius:8px;transition:background .15s ease;cursor:pointer;}
  .spec-item:hover{background:var(--surface-2);}
  .spec-item.checked{color:var(--text-muted);text-decoration:line-through;text-decoration-color:var(--border-hi);}
